# Copy to .env in the project root before running `docker compose up`.
# docker-compose.yml reads this automatically.

POSTGRES_PASSWORD=change-me-to-something-real

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Classic GitHub OAuth Apps only support one callback URL — register
# <NEXTAUTH_URL>/api/auth/callback/github exactly.
GITHUB_ID=
GITHUB_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email of the account to auto-promote to ADMINISTRATOR on first sign-in
INITIAL_ADMIN_EMAIL=

HASHEOUS_API_KEY=
HASHEOUS_ENV=beta
# Separate credential, only needed for IGDB release-date/summary enrichment
# — see .env.example for details on where to get one.
HASHEOUS_CLIENT_API_KEY=

# Rate limiting for /api/submissions, /api/submissions/[id]/verify,
# /api/submissions/[id]/patch, and /api/search. Free tier at
# https://upstash.com. Leave both blank to leave rate limiting off — see
# .env.example for details.

# Where uploaded patch files actually live on THIS host — a real folder,
# bind-mounted into the container (see the comment on the volume in
# docker-compose.yml/portainer-stack.yml). Optional: defaults to
# ./patch-storage, relative to wherever the compose file lives, if unset.
# Point it anywhere you want direct access to the files, e.g.:
#   PATCH_STORAGE_HOST_DIR=/examplefolder/Patches
# Whatever directory you pick needs to be writable by uid 1001 before the
# app starts — mkdir it, then `sudo chown 1001:1001 <dir>` (or `chmod 777
# <dir>` if you'd rather not deal with chown). This is a HOST path, not a
# container one — don't confuse it with PATCH_STORAGE_DIR (src/lib/
# patchStorage.ts), which is what the app reads INSIDE the container and is
# already hardcoded to /app/data/patches in both compose files; you don't
# need to set that one yourself for the Docker case.
PATCH_STORAGE_HOST_DIR=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
