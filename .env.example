# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/romhackdat"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Required if you access the app from anywhere other than NEXTAUTH_URL exactly
# (e.g. a LAN IP like https://192.168.1.x:3000). Without this, next-auth v4
# hard-locks every callback/redirect to NEXTAUTH_URL regardless of which host
# the request actually came in on — this is what causes sign-in to bounce back
# to localhost. Any truthy value works; "true" is conventional.
# (This is a real env var read directly from process.env by next-auth's core,
# not a config option — there is no equivalent `trustHost` field to set in
# src/lib/auth.ts for next-auth v4.)
AUTH_TRUST_HOST="true"

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# GitHub (recommended — most ROM hackers have GitHub accounts)
# IMPORTANT: classic GitHub OAuth Apps only support ONE callback URL — not
# multiple. If you need both http://localhost:3000 (same-machine dev) and
# something like https://192.168.1.x:3000 (LAN access) to work, you need two
# separate OAuth Apps, each with its own GITHUB_ID/GITHUB_SECRET, and you swap
# which one is active depending on how you're running the app that session.
# Register the callback URL as: <your-origin>/api/auth/callback/github
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# Discord (optional)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ROMHack DAT"

# ─── Initial Admin ────────────────────────────────────────────────────────────
# Set this to the email of the first user to auto-promote to ADMINISTRATOR
INITIAL_ADMIN_EMAIL=

# Hasheous integration (https://hasheous.org)
# Required for pushing mapping data (FixMatch). Pulling/lookup works without a key.
HASHEOUS_API_KEY=
# 'beta' uses beta.hasheous.org, 'production' uses hasheous.org
HASHEOUS_ENV=beta
# A SEPARATE credential from HASHEOUS_API_KEY above — required only for the
# optional IGDB release-date/summary enrichment (MetadataProxy calls), not
# for the main hash lookup/pull or for push. Without it, everything else
# still works (ids, links, canonical name/description all come from the
# main lookup) — you just won't get a release date on the canonical
# metadata block. To get one: on Hasheous, register/use an "App" you own,
# then generate a Client API Key from it (app/{id}/ClientApiKeys).
HASHEOUS_CLIENT_API_KEY=
# Auto-sync scheduler: pulls unsynced entries every 6h, pushes mappings every 30min.
# Starts automatically on server boot (instrumentation.ts). No extra config needed —
# just set HASHEOUS_ENV above. HASHEOUS_API_KEY is only required for push.
