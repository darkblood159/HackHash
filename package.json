  "description": "A self-hosted, community-driven DAT database for ROM hacks, fan translations, and homebrew — with Hasheous integration for shared game-database metadata.",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkblood159/HackHash"
  },
  "homepage": "https://github.com/darkblood159/HackHash",
  "private": true,
  "scripts": {
    "dev": "next dev",
